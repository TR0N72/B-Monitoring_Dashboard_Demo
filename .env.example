# Copy to .env and fill in. Never commit .env.
# docker-compose overrides MYSQL_HOST, MQTT_HOST and AI_SERVICE_URL for the backend container.

NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3002

# Auth
JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=24h

# MySQL (compose reads these too)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=bmonitor
MYSQL_USER=bmonitor_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# MQTT broker account used by the backend (must exist in docker/mosquitto/passwd, see README)
MQTT_HOST=mqtt://localhost
MQTT_PORT=1883
MQTT_USER=bmonitor_backend
MQTT_PASSWORD=change-me

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Telegram alerts (leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Actuator / safety tuning (defaults shown)
ACTUATOR_COOLDOWN_MS=600000
ACTUATOR_STEP_DELAY_MS=30000
FAILSAFE_VERIFY_WINDOW_MS=15000
VIBRATION_THRESHOLD=0.3
ALERT_COOLDOWN_MS=300000
CHAMBER_NODES=N1

# Measurement-cycle scheduler: empty or 0 = off. Minutes between START_CYCLE.
CYCLE_INTERVAL_MIN=
CYCLE_NODES=N1

# Device goes offline after this many seconds without data
DEVICE_OFFLINE_SEC=90

# AI: minimum confidence used for DSS (lower results are stored but ignored)
AI_MIN_CONFIDENCE=0.6
