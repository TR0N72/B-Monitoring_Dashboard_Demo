{
  "name": "bmonitor-backend",
  "version": "1.0.0",
  "description": "B-Monitor Express.js Backend API — Water Quality Monitoring System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest",
    "test:security": "jest --testPathPatterns=security --verbose",
    "test:watch": "jest --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/src/__tests__/**/*.test.js"
    ],
    "testTimeout": 10000
  },
  "dependencies": {
    "@influxdata/influxdb-client": "^1.35.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mqtt": "^5.10.0",
    "mysql2": "^3.11.0",
    "socket.io": "^4.7.5"
  },
  "keywords": [
    "bmonitor",
    "iot",
    "water-quality",
    "express",
    "lora"
  ],
  "license": "ISC",
  "devDependencies": {
    "axios": "^1.20.0",
    "jest": "^30.5.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  }
}
