{
  "uid": "bmonitor-main",
  "title": "B-Monitor Main",
  "schemaVersion": 38,
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Water Quality Trends",
      "type": "timeseries",
      "datasource": { "type": "mysql", "uid": "mysql" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT\n  recorded_at AS \"time\",\n  suhu AS \"Temperature\",\n  ph_level AS \"pH\",\n  salinitas AS \"Salinity\",\n  turbidity AS \"Turbidity\"\nFROM sensor_data\nWHERE\n  $__timeFilter(recorded_at)\nORDER BY recorded_at ASC",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Parameter Correlation",
      "type": "xychart",
      "datasource": { "type": "mysql", "uid": "mysql" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT\n  recorded_at AS \"time\",\n  suhu AS \"Temp\",\n  ph_level AS \"pH\"\nFROM sensor_data\nWHERE $__timeFilter(recorded_at)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Alert Frequency",
      "type": "barchart",
      "datasource": { "type": "mysql", "uid": "mysql" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "options": {
        "barChartOptions": { "stacking": "normal" }
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT\n  $__timeGroupAlias(created_at,1h),\n  level_peringatan AS metric,\n  count(id) AS value\nFROM alert_logs\nWHERE\n  $__timeFilter(created_at)\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A"
        }
      ]
    }
  ]
}
